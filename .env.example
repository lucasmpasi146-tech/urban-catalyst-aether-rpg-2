# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://aether:aether_local_password@127.0.0.1:5432/aether_rpg
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
REGISTRATION_CODE=change-this-to-a-long-private-code-before-registering
SINGLE_PLAYER_MODE=true
PGPOOL_MAX=5
